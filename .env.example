# ============================================================
# SIGELAB-INCOS - Variables de entorno
# Copiar este archivo a .env y ajustar los valores.
# ============================================================

# Direccion base del nucleo SIA-INCOS, SIN barra final.
# Produccion (Railway):
#   API_ACADEMICO_URL=https://sia-incos-demo.up.railway.app
# Simulador local incluido (npm run mock-sia):
#   API_ACADEMICO_URL=http://127.0.0.1:3000
API_ACADEMICO_URL=http://127.0.0.1:3000

# Puerto del demo SIGELAB (segun contrato: 4100)
PORT=4100

# ------------------------------------------------------------
# Almacenamiento propio del SIGELAB
# ------------------------------------------------------------
# auto      -> Firestore si existe serviceAccountKey.json; si no, archivo JSON local
# firestore -> obliga a Firebase (falla si falta la clave)
# file      -> archivo local data/store.json
DB_BACKEND=auto

# Firebase (proyecto del SIGELAB)
# Descargar el service account desde:
# Firebase Console > Configuracion del proyecto > Cuentas de servicio
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=incos-sigelab-2026

# Alternativa: credenciales en una sola variable JSON
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Emulador de Firestore (opcional, para desarrollo sin credenciales)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
