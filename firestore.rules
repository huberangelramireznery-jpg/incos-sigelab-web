rules_version = '2';

// El SIGELAB accede a Firestore únicamente desde el servidor Node.js
// mediante el SDK de administrador (firebase-admin), que omite estas reglas.
// Por seguridad, se bloquea todo acceso directo desde clientes web/móviles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
