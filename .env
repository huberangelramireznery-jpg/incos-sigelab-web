# ============================================================
# SIGELAB-INCOS - Entorno de desarrollo/demo
# Este archivo NO contiene secretos y puede versionarse.
# Las credenciales de Firebase van en serviceAccountKey.json
# (ignorado por Git).
# ============================================================

# Nucleo SIA. Por defecto se usa el simulador incluido en el proyecto.
# Cambiar a https://sia-incos-demo.up.railway.app cuando el nucleo real este en linea.
API_ACADEMICO_URL=http://127.0.0.1:3000

PORT=4100

# auto       -> Firestore si existe serviceAccountKey.json; si no, archivo local
# firestore  -> obliga a usar Firebase (falla si falta la clave)
# file       -> archivo data/store.json
DB_BACKEND=auto

# Firebase (proyecto del SIGELAB)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=incos-sigelab-2026
